  "db_name": "MySQL",
  "query": "\nSELECT\n    v.`id`,\n    v.`package`,\n    v.`description`,\n    v.`short_description`,\n    v.`author`,\n    v.`version`,\n    v.`bot_version`,\n    p.`name`,\n    v.`github`\nFROM versions AS v\nJOIN packages AS p\nON (v.`package`=p.`id`)\nORDER BY p.`id` DESC, v.`id` DESC;",
