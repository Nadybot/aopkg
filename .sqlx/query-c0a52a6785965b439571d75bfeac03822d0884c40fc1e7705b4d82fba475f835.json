{
  "db_name": "MySQL",
  "query": "\nSELECT\n    r.`package_version`,\n    r.`name`,\n    r.`version`\nFROM requirements AS r\nWHERE r.`package_version` IN (\n    SELECT\n        DISTINCT v.`id`\n    FROM versions AS v\n    JOIN packages AS p\n    ON (v.`package`=p.`id`)\n    WHERE p.`name`=?\n)\nORDER BY r.`package_version` DESC;\n        ",
